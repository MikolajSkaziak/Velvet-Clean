---
import { Image } from 'astro:assets';
import { ArrowRight, Camera, CalendarDays, Check, Droplets, Phone, Wind } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Results from '../components/Results.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import CallBar from '../components/CallBar.astro';
import { contact, rating, services, type Service } from '../data/site';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service: s } = Astro.props as { service: Service };
const home = new URL('/', Astro.site).href;
const url = new URL(`/${s.slug}`, Astro.site).href;
const lead = s.pairs[1] ?? s.pairs[0];
const others = services.filter((o) => o.slug !== s.slug);

const process = [
  { icon: Camera, title: 'Zdjęcie', text: 'Wyślij zdjęcie na WhatsApp lub Messengerze. Wycenę dostaniesz w kilka minut.' },
  { icon: CalendarDays, title: 'Termin', text: 'Umawiamy dzień i przyjeżdżamy do Ciebie. W Kaliszu i okolicach dojazd jest gratis.' },
  { icon: Droplets, title: 'Pranie', text: 'Maszyna wtłacza w tkaninę wodę ze środkiem i od razu odsysa ją razem z brudem.' },
  { icon: Wind, title: 'Suszenie', text: 'Odciągamy jak najwięcej wody i suszymy na miejscu. Gotowe po kilku godzinach.' },
];

// The business node lives on the home page; Google reads each page on its own, so the provider repeats the basics.
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${url}#usluga`,
      name: s.h1,
      serviceType: s.serviceType,
      description: s.description,
      url,
      areaServed: { '@type': 'City', name: 'Kalisz' },
      provider: {
        '@type': 'LocalBusiness',
        '@id': `${home}#firma`,
        name: 'Velvet Clean',
        url: home,
        telephone: contact.phoneIntl.replaceAll(' ', ''),
        address: { '@type': 'PostalAddress', streetAddress: 'ul. Górnośląska', postalCode: '62-800', addressLocality: 'Kalisz', addressCountry: 'PL' },
      },
      ...(s.from && { offers: { '@type': 'Offer', priceSpecification: { '@type': 'PriceSpecification', minPrice: s.from, priceCurrency: 'PLN' } } }),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Velvet Clean', item: home },
        { '@type': 'ListItem', position: 2, name: s.serviceType, item: url },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: s.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---

<Base title={s.title} description={s.description} schema={schema}>
  <Header />
  <main id="top">
    <section class="wrap intro" aria-labelledby="h-usluga">
      <hr class="stitch" />
      <div class="intro__text">
      <nav class="crumbs label" aria-label="Jesteś tutaj">
        <a href="/">Velvet Clean</a><span aria-hidden="true">/</span><span aria-current="page">{s.serviceType}</span>
      </nav>
      <h1 id="h-usluga">{s.h1}</h1>
      <p class="lede">{s.lede}</p>
      <dl class="facts">
        <div><dt class="label">Cena</dt><dd>{s.from ? `od ${s.from} zł` : 'Ze zdjęcia'}</dd></div>
        <div><dt class="label">Dojazd</dt><dd>Gratis</dd></div>
        <div><dt class="label">Suszenie</dt><dd>W cenie</dd></div>
        <div><dt class="label">Google</dt><dd><a href={contact.googleMaps} target="_blank" rel="noopener">{rating.score} · {rating.count} ocen</a></dd></div>
      </dl>
      <div class="actions">
        <a class="btn btn--primary" href={contact.tel}><Phone size={18} stroke-width={1.5} aria-hidden="true" />Zadzwoń · {contact.phoneDisplay}</a>
        <a class="link" href={contact.whatsapp} target="_blank" rel="noopener">Wyślij zdjęcie do wyceny<ArrowRight size={16} stroke-width={1.5} aria-hidden="true" /></a>
      </div>
      </div>
      <figure class="frame intro__photo">
        <Image src={lead.after} alt={lead.afterAlt} widths={[360, 540, 720]} sizes="(max-width: 900px) 60vw, 320px" loading="eager" />
        <figcaption class="label">Po praniu</figcaption>
      </figure>
    </section>

    <Results items={s.pairs} intro="Realizacje z Kalisza i okolic, sfotografowane telefonem na miejscu, tuż przed praniem i zaraz po nim." />

    <section class="section section--tight" aria-labelledby="h-zakres">
      <div class="wrap scope">
        <hr class="stitch" />
        <div>
          <h2 id="h-zakres">Co pierzemy</h2>
          <ul class="includes">
            {s.includes.map((item) => <li><Check class="icon" size={18} stroke-width={1.5} aria-hidden="true" />{item}</li>)}
          </ul>
        </div>
        <div>
          <h2 class="h-small">Jak to wygląda</h2>
          <ol class="process">
            {process.map(({ icon: Icon, ...p }) => <li><h3><Icon class="icon" size={20} stroke-width={1.5} aria-hidden="true" />{p.title}</h3><p>{p.text}</p></li>)}
          </ol>
        </div>
      </div>
    </section>

    <Faq items={s.faq} />

    <section class="section section--tight" aria-label="Inne usługi">
      <div class="wrap more">
        <hr class="stitch" />
        <p class="label">Pierzemy też</p>
        <ul>
          <li><a class="link" href="/#cennik">Kanapy, narożniki, materace i fotele<ArrowRight size={16} stroke-width={1.5} aria-hidden="true" /></a></li>
          {others.map((o) => <li><a class="link" href={`/${o.slug}`}>{o.serviceType}<ArrowRight size={16} stroke-width={1.5} aria-hidden="true" /></a></li>)}
        </ul>
      </div>
    </section>

    <Contact />
  </main>
  <Footer />
  <CallBar />
</Base>

<style>
  .intro { padding-top: clamp(40px, 6vw, 80px); display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0 clamp(40px, 6vw, 96px); align-items: end; }
  .intro > .stitch { grid-column: 1 / -1; margin-bottom: clamp(32px, 4vw, 56px); }
  .intro__text { display: grid; gap: 26px; justify-items: start; }
  .intro__photo { margin: 0; width: clamp(220px, 22vw, 320px); }
  .intro__photo :global(img) { display: block; width: 100%; aspect-ratio: 3 / 4; object-fit: cover; }
  .intro__photo figcaption { position: absolute; left: 21px; bottom: 21px; padding: 7px 10px; background: rgba(237, 231, 221, 0.9); }
  .crumbs { display: flex; flex-wrap: wrap; gap: 10px; }
  .crumbs a { text-decoration: none; padding-block: 4px; }
  @media (hover: hover) and (pointer: fine) { .crumbs a:hover { color: var(--ink); } }
  h1 { font-size: clamp(2.4rem, 6.4vw, 5.2rem); letter-spacing: 0.08em; line-height: 0.98; max-width: 14em; overflow-wrap: anywhere; }
  .lede { max-width: 36em; color: var(--ink-soft); font-size: 1.05rem; }
  .facts { margin: 8px 0 0; display: grid; grid-template-columns: repeat(4, auto); gap: 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .facts div { padding: 16px 32px 16px 0; display: grid; gap: 6px; }
  .facts div + div { padding-left: 32px; border-left: 1px solid var(--line); }
  .facts dd { margin: 0; font: 300 1.5rem/1 var(--display); letter-spacing: 0.06em; text-transform: uppercase; white-space: nowrap; }
  .facts a { text-decoration: none; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 28px; margin-top: 6px; }

  .scope { display: grid; grid-template-columns: 1fr 1.2fr; gap: 40px clamp(40px, 7vw, 120px); }
  .scope > .stitch { grid-column: 1 / -1; margin-bottom: 0; }
  .scope h2 { margin-bottom: 28px; }
  .h-small { font-size: clamp(2rem, 3.6vw, 3rem); }
  .includes { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .includes li { display: flex; align-items: center; gap: 12px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .includes :global(.icon), .process :global(.icon) { flex: none; color: var(--blue); }
  .process { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
  .process li { display: grid; gap: 10px; align-content: start; }
  .process h3 { display: flex; align-items: center; gap: 10px; }
  .process p { color: var(--ink-soft); font-size: 0.97rem; }

  .more { display: grid; gap: 18px; }
  .more > .stitch { margin-bottom: 12px; }
  .more ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 14px 40px; }

  @media (max-width: 900px) {
    .intro { grid-template-columns: minmax(0, 1fr); }
    .intro__photo { display: none; }
    .scope { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 640px) {
    .facts { grid-template-columns: 1fr 1fr; width: 100%; }
    .facts div, .facts div + div { padding: 14px 0; border-left: 0; }
    .facts div:nth-child(even) { padding-left: 20px; border-left: 1px solid var(--line); }
    .facts div:nth-child(-n + 2) { border-bottom: 1px solid var(--line); }
    .process { grid-template-columns: 1fr; }
  }
</style>
