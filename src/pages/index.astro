---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Results from '../components/Results.astro';
import Prices from '../components/Prices.astro';
import Route from '../components/Route.astro';
import Reviews from '../components/Reviews.astro';
import Expo from '../components/Expo.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import CallBar from '../components/CallBar.astro';
---

<Base
  title="Velvet Clean · Pranie tapicerki Kalisz"
  description="Pranie tapicerki u Ciebie w domu: kanapy, narożniki, materace, fotele i wnętrza aut. Kalisz i okolice, dojazd i suszenie w cenie."
>
  <Header />
  <main id="top">
    <Hero />
    <Results />
    <Prices />
    <Route />
    <Reviews />
    <Expo />
    <Faq />
    <Contact />
  </main>
  <Footer />
  <CallBar />
</Base>
