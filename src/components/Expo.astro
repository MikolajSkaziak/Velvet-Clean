---
import { Image } from 'astro:assets';
import expo from '../assets/img/expo.webp';
---

<section class="wrap" aria-labelledby="h-expo">
  <div class="frame expo">
    <Image src={expo} alt="Sprzęt do prania tapicerki na stoisku targów Cleaning Expo w Poznaniu" widths={[560, 840]} sizes="(max-width: 860px) 100vw, 45vw" />
    <div class="copy">
      <h2 id="h-expo">Cleaning Expo 2026, Poznań</h2>
      <p class="muted">W październiku byliśmy na targach Cleaning Expo i Cleaning Forum. Sprawdzaliśmy nowe środki i sprzęt, żeby prać skuteczniej i bezpieczniej dla Twojego domu.</p>
    </div>
  </div>
</section>

<style>
  .expo { display: grid; grid-template-columns: 1fr 1.1fr; }
  .expo :global(img) { width: 100%; height: 100%; min-height: 380px; object-fit: cover; filter: saturate(0.75); }
  .copy { padding: clamp(32px, 5vw, 72px); display: grid; gap: 22px; align-content: center; }
  h2 { font-size: clamp(2.2rem, 4vw, 3.4rem); }
  @media (max-width: 860px) { .expo { grid-template-columns: 1fr; } .expo :global(img) { min-height: 0; aspect-ratio: 16 / 10; } }
</style>
