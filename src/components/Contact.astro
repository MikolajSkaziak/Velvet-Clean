---
import { Camera, MapPin, Phone, Truck, Wind } from '@lucide/astro';
import { contact } from '../data/site';
---

<section class="contact" id="kontakt" aria-labelledby="h-kontakt">
  <div class="wrap grid">
    <div class="main">
      <h2 id="h-kontakt">Umów pranie. Resztą zajmiemy się u Ciebie.</h2>
      <a class="phone" href={contact.tel}>{contact.phoneDisplay}</a>
      <div class="actions">
        <a class="btn btn--light" href={contact.tel}><Phone size={18} stroke-width={1.5} aria-hidden="true" />Zadzwoń</a>
        <a class="btn btn--ghost" href={contact.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
        <a class="btn btn--ghost" href={contact.messenger} target="_blank" rel="noopener">Messenger</a>
      </div>
    </div>
    <div class="tag">
      <span class="bead" aria-hidden="true"></span>
      <dl>
        <div><dt class="label"><MapPin class="icon" size={16} stroke-width={1.5} aria-hidden="true" />Obszar</dt><dd>{contact.area}</dd></div>
        <div><dt class="label"><Truck class="icon" size={16} stroke-width={1.5} aria-hidden="true" />Dojazd</dt><dd>Gratis</dd></div>
        <div><dt class="label"><Wind class="icon" size={16} stroke-width={1.5} aria-hidden="true" />Suszenie</dt><dd>W cenie</dd></div>
        <div><dt class="label"><Camera class="icon" size={16} stroke-width={1.5} aria-hidden="true" />Wycena</dt><dd>Ze zdjęcia, WhatsApp lub Messenger</dd></div>
      </dl>
    </div>
  </div>
</section>

<style>
  /* The closing band is the logo inverted: cream on navy. */
  .contact { background: var(--ink); color: var(--paper); padding-block: clamp(96px, 13vw, 180px); }
  .grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 36px 72px; align-items: center; }
  .main { display: grid; gap: 36px; }
  h2 { font-size: clamp(2.4rem, 4.6vw, 3.8rem); max-width: 14em; }
  .phone { font: 300 clamp(3.6rem, 10vw, 6rem)/0.9 var(--display); letter-spacing: 0.06em; text-decoration: none; width: fit-content; font-variant-numeric: tabular-nums; }
  .actions { display: flex; flex-wrap: wrap; gap: 20px 0; }
  .actions .btn { color: var(--paper); border-color: rgba(237, 231, 221, 0.4); }
  .actions .btn::before { border-color: rgba(237, 231, 221, 0.2); }
  .actions .btn::after { background: radial-gradient(circle at calc(100% - 13px) 50%, var(--paper) 3.5px, transparent 4px), linear-gradient(var(--paper), var(--paper)) 0 50% / 100% 1px no-repeat; }
  .actions .btn--light { background: var(--paper); color: var(--ink); border-color: var(--paper); }
  .actions .btn--light::before { border-color: var(--line-strong); }
  @media (hover: hover) and (pointer: fine) {
    .actions .btn--ghost:hover { border-color: var(--paper); }
    .actions .btn--light:hover { background: var(--cream); }
  }
  .label { color: rgba(237, 231, 221, 0.72); }
  /* the blue focus ring disappears on navy; use the paper colour here */
  .contact :focus-visible { outline-color: var(--paper); }
  .tag { position: relative; border: 1px solid rgba(237, 231, 221, 0.4); padding: 34px 34px 30px; }
  .tag::after { content: ""; position: absolute; inset: 4px; border: 1px dashed rgba(237, 231, 221, 0.2); pointer-events: none; }
  .tag::before { content: ""; position: absolute; left: 50%; bottom: 100%; width: 1px; height: 120px; background: #8fa9c4; }
  .bead { position: absolute; left: 50%; top: -128px; width: 11px; height: 11px; margin-left: -5.5px; border-radius: 50%; background: #8fa9c4; }
  dl { margin: 0; display: grid; }
  dl div { display: grid; grid-template-columns: 9em 1fr; gap: 16px; padding: 14px 0; border-bottom: 1px solid rgba(237, 231, 221, 0.16); }
  dl div:last-child { border-bottom: 0; }
  dt { display: flex; align-items: center; gap: 10px; }
  dt :global(.icon) { flex: none; color: #8fa9c4; }
  dd { margin: 0; font: 400 1.2rem/1.3 var(--display); letter-spacing: 0.1em; text-transform: uppercase; }
  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
    .tag { margin-top: 40px; }
    .tag::before { height: 40px; }
    .bead { top: -48px; }
    dl div { grid-template-columns: 7em 1fr; }
  }
</style>
